  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ReplaceVanillaBuildMenu]": "Replace the vanilla build menu",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ReplaceVanillaBuildMenu]": "When you click a toolbar menu such as Electricity or Roads, opens the panel already filtered to that menu instead of the vanilla asset grid. Turn off to get the stock icon row back. With a controller, the game's own build menu shows.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AutoWidenSearch]": "Searching widens automatically",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AutoWidenSearch]": "When a search finds nothing in the current category, drop the category and search every menu at once. Off by default: the panel offers to widen instead, so the category you were browsing is kept.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AssetMenuTileSize]": "Tile size",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AssetMenuTileSize]": "Sizes the Tiles view. 64 shows 2 rows of 10, 68 shows 2 rows of 9; above 68 the menu shows one row unless you drag it taller.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AssetMenuWidthStep]": "Width",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AssetMenuWidthStep]": "How wide the build menu is, in every menu. 1 is the game's own size; each step adds columns. 4 and 5 cover the chirper. On a wider screen each step is wider. Beside the control pane, a step that does not fit draws as the widest that does. You can also drag the menu's right edge, or use View › Width.",
  "Options.LABEL[BetterBuildingMenu.WidthStep1]": "1 · the game's size",
  "Options.LABEL[BetterBuildingMenu.WidthStep2]": "2",
  "Options.LABEL[BetterBuildingMenu.WidthStep3]": "3",
  "Options.LABEL[BetterBuildingMenu.WidthStep4]": "4 · covers the chirper",
  "Options.LABEL[BetterBuildingMenu.WidthStep5]": "5 · covers the chirper",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DefaultView]": "Default view",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DefaultView]": "Auto: the view each menu suits, a list where most buildings have a cost or a capacity, tiles for zones and prop catalogues. Cards: the larger cards with the whole name, in every menu; Auto never picks them. Pick a view for one menu with View on the menu's top row; that pick wins.",
  "Options.LABEL[BetterBuildingMenu.DefaultViewAuto]": "Auto",
  "Options.LABEL[BetterBuildingMenu.DefaultViewList]": "List",
  "Options.LABEL[BetterBuildingMenu.DefaultViewTiles]": "Tiles",
  "Options.LABEL[BetterBuildingMenu.DefaultViewCards]": "Cards",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AtLargeText]": "At large text",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AtLargeText]": "Above 100% text scale. More buildings: 18 a screen, with long names shortened. Whole names: 12 a screen, each name whole.",
  "Options.LABEL[BetterBuildingMenu.AtLargeTextMoreBuildings]": "More buildings",
  "Options.LABEL[BetterBuildingMenu.AtLargeTextWholeNames]": "Whole names",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ControlPaneShown]": "Control pane",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ControlPaneShown]": "Shows Sort, Filter, Group and View again in a pane beside the menu. The menu's top row has them either way. The pane covers the chirper.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ResetBuildMenu]": "Reset the build menu…",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ResetBuildMenu]": "Puts every option here, the menu's width and height and each menu's own view and group back to how they ship. The buildings you have placed are kept.",
  "Options.WARNING[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ResetBuildMenu]": "Put every Better Building Menu setting, the width, each menu's own view and group and the menu's size back to how they ship? The buildings you have placed are kept.",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.OffWhileReplaceOff]": "Off while Replace the vanilla build menu is off.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevSlotMargin]": "Slot margin",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevSlotMargin]": "Developer mode only. How many more placements, in percent, a building needs than the less placed of a menu's two slots to take its place. 25 ships; at 0 a tie is enough.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevPickLogger]": "Pick logger",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevPickLogger]": "Developer mode only. Writes a line for each building armed, each swap and each placement to picks.jsonl in the mod's ModsData folder, on this computer. Nothing is sent anywhere, and Reset the build menu… leaves the file alone.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevInterfaceStyles]": "Interface styles",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevInterfaceStyles]": "Developer mode only. On, as it ships, the build menu follows the game's interface style. Off, it keeps its own colours under every style, to compare.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevTabNames]": "Tab names",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevTabNames]": "Developer mode only. On, as it ships, a menu wider than the first Width step shows each tab's name beside its icon when every tab fits that way. Off, the tabs keep their icon over their count at every width, to compare.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevListShare]": "List share",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevListShare]": "Developer mode only. Auto draws a menu as a list where at least this share of its buildings carry what counts; ships at 50%.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevWhatCounts]": "What counts",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevWhatCounts]": "Developer mode only. What a building needs for Auto to count it toward a list: a cost or a capacity, as it ships, or a capacity only.",
  "Options.LABEL[BetterBuildingMenu.WhatCountsCostOrCapacity]": "Cost or capacity",
  "Options.LABEL[BetterBuildingMenu.WhatCountsCapacityOnly]": "Capacity only",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevAutoLargeText]": "Auto at large text",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevAutoLargeText]": "Developer mode only. Above 100% text scale, Roads and Parks keep the look's own view, as it ships, or show the list or the tiles.",
  "Options.LABEL[BetterBuildingMenu.AutoLargeTextLookOwn]": "Look's own",
  "Options.LABEL[BetterBuildingMenu.AutoLargeTextList]": "List",
  "Options.LABEL[BetterBuildingMenu.AutoLargeTextTiles]": "Tiles",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevCardsFrom]": "Cards from width",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevCardsFrom]": "Developer mode only. The Width step from which Auto shows cards. Never, as it ships, so Auto draws the list or the tiles at every width. A step draws cards from that Width on.",
  "Options.LABEL[BetterBuildingMenu.CardsFromNever]": "Never",
  "Options.LABEL[BetterBuildingMenu.CardsFrom2]": "2",
  "Options.LABEL[BetterBuildingMenu.CardsFrom3]": "3",
  "Options.LABEL[BetterBuildingMenu.CardsFrom4]": "4",
  "Options.LABEL[BetterBuildingMenu.CardsFrom5]": "5",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevListPlateHeight]": "List plate height",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevListPlateHeight]": "Developer mode only. The height of each building in the list at 100% text; ships at 27.25, five lines to the game's own menu height.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevNameLines]": "Name lines",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevNameLines]": "Developer mode only. How many lines a name takes in the list: the look's own, as it ships, or always one or two.",
  "Options.LABEL[BetterBuildingMenu.NameLinesAuto]": "Look's own",
