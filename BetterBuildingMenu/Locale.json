  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevTileNameLine]": "Tile name line",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevTileNameLine]": "Developer mode only. On, as it ships, the Tiles view names the building you point at, or the one picked, on a line under its tiles. Off, to compare.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevBlockLabels]": "Block labels",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.DevBlockLabels]": "Developer mode only. A group's name and Locked take one place in line with the buildings, as it ships, or start a line of their own, to compare.",
