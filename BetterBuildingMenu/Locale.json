  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ReplaceVanillaBuildMenu]": "Replace the vanilla build menu",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ReplaceVanillaBuildMenu]": "Opens the Building Lens, already filtered, when you click a vanilla toolbar menu such as Electricity or Healthcare, instead of the vanilla asset grid. Roads and Landscaping are unaffected, since they contain networks and surfaces rather than buildings.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ReplaceVanillaZonesMenu]": "Zones menu opens the zoning hierarchy",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.ReplaceVanillaZonesMenu]": "When replacing the vanilla build menu, the Zones button opens a browsable zoning hierarchy — family, then density, then the zones themselves — instead of the vanilla zone grid. Assignment still uses the game’s own Zone tool. Turn off to keep the familiar grid while still replacing the service menus.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AutoWidenSearch]": "Searching widens automatically",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.AutoWidenSearch]": "When a search finds nothing in the current category, drop the category and search everything immediately. Off by default, so the lens offers to widen instead of silently discarding the category you were browsing.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensDefaultToTable]": "Open in comparison table",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensDefaultToTable]": "Start the lens in the data table rather than the thumbnail grid. The grid is faster to recognise and place from; the table is for comparing costs, capacities and upkeep across many buildings. You can switch at any time without changing this.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensShowShelf]": "Show frequently placed",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensShowShelf]": "Pin the buildings you place most often above the grid, at positions that do not move, so repeat placement becomes a single click. Hidden while a search is active.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensShelfSize]": "Frequently placed slots",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensShelfSize]": "How many buildings the shelf holds. Deliberately small: a shelf whose shape you cannot learn is just another list.",
  "Options.OPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensTileSize]": "Tile size",
  "Options.OPTION_DESCRIPTION[BetterBuildingMenu.BetterBuildingMenu.Mod.BetterBuildingMenuSettings.BuildingLensTileSize]": "Width of each building tile in the grid. Larger tiles are easier to recognise by silhouette; smaller ones fit more on screen.",
  "Tooltip.LABEL[BetterBuildingMenu.RolePowerPlant]": "Power plant",
