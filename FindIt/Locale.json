  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.ReplaceVanillaBuildMenu]": "Replace the vanilla build menu",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.ReplaceVanillaBuildMenu]": "Opens the Building Lens, already filtered, when you click a vanilla toolbar menu such as Electricity or Healthcare, instead of the vanilla asset grid. Roads and Landscaping are unaffected, since they contain networks and surfaces rather than buildings.",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.ReplaceVanillaZonesMenu]": "Zones menu opens the zoning hierarchy",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.ReplaceVanillaZonesMenu]": "When replacing the vanilla build menu, the Zones button opens a browsable zoning hierarchy — family, then density, then the zones themselves — instead of the vanilla zone grid. Assignment still uses the game’s own Zone tool. Turn off to keep the familiar grid while still replacing the service menus.",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.AutoWidenSearch]": "Searching widens automatically",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.AutoWidenSearch]": "When a search finds nothing in the current category, drop the category and search everything immediately. Off by default, so the lens offers to widen instead of silently discarding the category you were browsing.",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensDefaultToTable]": "Open in comparison table",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensDefaultToTable]": "Start the lens in the data table rather than the thumbnail grid. The grid is faster to recognise and place from; the table is for comparing costs, capacities and upkeep across many buildings. You can switch at any time without changing this.",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensShowShelf]": "Show frequently placed",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensShowShelf]": "Pin the buildings you place most often above the grid, at positions that do not move, so repeat placement becomes a single click. Hidden while a search is active.",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensShelfSize]": "Frequently placed slots",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensShelfSize]": "How many buildings the shelf holds. Deliberately small: a shelf whose shape you cannot learn is just another list.",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensTileSize]": "Tile size",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.BuildingLensTileSize]": "Width of each building tile in the grid. Larger tiles are easier to recognise by silhouette; smaller ones fit more on screen.",
  "Tooltip.LABEL[FindItBuildingMenu.RolePowerPlant]": "Power plant",
  "Options.OPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.ShowCoverageOverlay]": "Show coverage map while placing",
  "Options.OPTION_DESCRIPTION[FindItBuildingMenu.FindItBuildingMenu.Mod.FindItSettings.ShowCoverageOverlay]": "While a service building is on the tool, switch the map to that service’s coverage view, so you can see where it is needed before placing. Your previous map view is restored when you put the tool down.",
