<Project>

  <!--
    Shared MSBuild defaults for the mod and its tests.
  -->

  <!-- CS2 game path: env var with fallback to the default Steam install. -->
  <PropertyGroup>
    <CS2GamePath Condition="'$(CS2GamePath)' == ''">$([System.Environment]::GetEnvironmentVariable('CS2_GAME_PATH'))</CS2GamePath>
    <CS2GamePath Condition="'$(CS2GamePath)' == '' And '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)\Steam\steamapps\common\Cities Skylines II</CS2GamePath>
    <CS2GamePath Condition="'$(CS2GamePath)' == ''">$([System.Environment]::GetEnvironmentVariable('HOME'))/.local/share/Steam/steamapps/common/Cities Skylines II</CS2GamePath>
    <CS2ManagedPath>$(CS2GamePath)/Cities2_Data/Managed</CS2ManagedPath>
  </PropertyGroup>

  <!-- Default framework/language settings. Projects may override by
       re-declaring (props import first; a later project assignment wins),
       e.g. the *Tests projects set <TargetFramework>net10.0</TargetFramework>. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Warnings fail the build in CI, which sets CI=true: the compiler's and the analyzers'
         (TreatWarningsAsErrors), and MSBuild's and NuGet's (MSBuildTreatWarningsAsErrors). Both
         projects build without one, so a new one is a real problem: most often a missing null
         check, or an annotation that does not match the code. Locally they stay warnings: that
         build is the one played, and a game or SDK update that adds a warning should not stop it.
         NuGet's vulnerability audit (NU1900-NU1904) stays a warning even in CI: a feed that is
         down, or an advisory published tomorrow, should not fail a change that touched neither. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</MSBuildTreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</MSBuildWarningsNotAsErrors>
  </PropertyGroup>

  <!-- Keep UI node_modules trees out of the C# item graph. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
